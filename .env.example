# Local Node/Express development only. Do not commit a real .env file.
NODE_ENV=development
PORT=3000
SESSION_DAYS=7
APP_BASE_URL=http://localhost:3000

# Optional stock quote providers. Check API plan and commercial display rights.
STOCK_PROVIDER_ORDER=alpha,fmp,eod
ALPHA_VANTAGE_KEY=
FMP_KEY=
EODHD_KEY=

# SEC EDGAR requires a real monitored contact email in the User-Agent.
SEC_USER_AGENT=RaelInfo/3.0 contact=YOUR-MONITORED-EMAIL@example.com

# Local Express development only. Cloudflare Pages uses its dashboard environment
# variables and secrets instead of this file.
ALLOWED_ORIGIN=http://localhost:3000
